# Default demo needs no credentials.
# To use live databases, configure config/targets.json and the following variables.
# Never commit .env to Git.
PG_PROD_DSN=host=127.0.0.1 port=5432 dbname=postgres user=dba_readonly password=CHANGE_ME sslmode=require
MSSQL_PROD_DSN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=127.0.0.1,1433;DATABASE=master;UID=dba_readonly;PWD=CHANGE_ME;Encrypt=yes;TrustServerCertificate=no;
# Recommended if API is exposed beyond local development
DBA_AGENT_API_KEY=
# Optional: enables LLM intent routing (otherwise uses built-in Vietnamese intent rules)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
